DEEPSEEK_API_KEY=replace-with-your-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional application overrides (defaults shown)
RAG_PDF_PATH=data/raw/城市轨道交通工程设计标准.pdf
RAG_INDEX_DIR=.rag_index
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_EMBEDDING_REVISION=
RAG_RERANKER_MODEL=BAAI/bge-reranker-base
RAG_RETRIEVAL_TOP_K=10
RAG_EVIDENCE_TOP_N=3
RAG_REQUEST_TIMEOUT_SECONDS=30
RAG_MAX_NETWORK_RETRIES=1
RAG_TOTAL_TIMEOUT_SECONDS=90
RAG_MAX_MODEL_CALLS=6
RAG_INDEX_AUTO_BUILD=true
RAG_INDEX_LOCK_TIMEOUT_SECONDS=30

