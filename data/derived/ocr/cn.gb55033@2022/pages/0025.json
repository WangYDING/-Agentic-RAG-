0,821.0],[961.0,856.0],[142.0,854.0]],"text":"方向的栅栏门，检票口和栅栏门的总通过能力应保证站台疏散至"},{"confidence":0.99896,"polygon":[[143.0,864.0],[508.0,864.0],[508.0,897.0],[143.0,897.0]],"text":"站厅的乘客不滞留在付费区。"},{"confidence":0.99248,"polygon":[[140.0,907.0],[961.0,909.0],[961.0,942.0],[140.0,940.0]],"text":"5.4.7 城市轨道交通车站检票口应至少设置一处无障碍专用检"},{"confidence":0.99864,"polygon":[[142.0,949.0],[620.0,949.0],[620.0,988.0],[142.0,988.0]],"text":"票通道，通道净宽不应小于900mm。"},{"confidence":0.99744,"polygon":[[141.0,993.0],[961.0,995.0],[961.0,1031.0],[141.0,1029.0]],"text":"5.4.8当车站不设置站台屏蔽门时，站台边缘应设置醒目的安"},{"confidence":0.99981,"polygon":[[145.0,1042.0],[959.0,1042.0],[959.0,1072.0],[145.0,1072.0]],"text":"全带或安全线标志；当车站设置站台屏蔽门时，自站台边缘起向"},{"confidence":0.99982,"polygon":[[144.0,1085.0],[734.0,1086.0],[734.0,1116.0],[144.0,1115.0]],"text":"内1m范围内的地面装饰层下应采取绝缘措施。"},{"confidence":0.99662,"polygon":[[140.0,1126.0],[961.0,1128.0],[961.0,1161.0],[140.0,1159.0]],"text":"5.4.9 跨座式单轨系统车站站台应设站台屏蔽门，高架车站底"},{"confidence":0.9999,"polygon":[[141.0,1169.0],[277.0,1172.0],[276.0,1207.0],[141.0,1204.0]],"text":"部应封闭。"},{"confidence":0.99246,"polygon":[[140.0,1214.0],[960.0,1215.0],[960.0,1248.0],[140.0,1247.0]],"text":"5.4.10 地下车站风亭（井）的设置应能防止气流短路，并应符"},{"confidence":0.99984,"polygon":[[144.0,1259.0],[363.0,1259.0],[363.0,1289.0],[144.0,1289.0]],"text":"合环境保护要求。"},{"confidence":0.99648,"polygon":[[140.0,1300.0],[961.0,1301.0],[961.0,1334.0],[140.0,1333.0]],"text":"5.4.11 车站内应设置导向、事故疏散等标志标识，区间隧道应"},{"confidence":0.99981,"polygon":[[141.0,1344.0],[306.0,1346.0],[306.0,1380.0],[141.0,1378.0]],"text":"设疏散标志。"},{"confidence":0.9859,"polygon":[[140.0,1389.0],[565.0,1389.0],[565.0,1419.0],[140.0,1419.0]],"text":"5.4.12 车站内应设无障碍设施。"},{"confidence":0.99998,"polygon":[[900.0,1446.0],[941.0,1446.0],[941.0,1480.0],[900.0,1480.0]],"text":"21"}],"page_number":25,"render_dpi":200,"schema_version":1,"source_pdf_sha256":"907ffd92c569f79f163121904cccce69bc20905f9563854960bd184ca76f6fef","spec_id":"cn.gb55033","text":"列规定：\n1 岛式站台车站的乘降区宽度不应小于2.5m，站台宽度不\n应小于8m；\n2 侧式站台车站，平行于线路方向设置楼扶梯时站台乘降\n区宽度不应小于2.5m，垂直于侧站台设置楼扶梯时乘降区宽度\nV\n不应小于3.5m。\n5.4.4当采用有轨电车系统时，岛式站台的宽度不应小于5m，\n侧式站台的宽度不应小于3m。\n1 天桥和通道宽度不应小于 2.4m；\n2 单向公共区人行楼梯宽度不应小于1.8m；\n3 双向公共区人行楼梯宽度不应小于 2.4m;\n4 消防专用楼梯宽度不应小于1.2m，站台至轨行区的工作\n梯（兼疏散梯）宽度不应小于1.1m，区间风井疏散梯宽度不应\n小于1.8m。\n5.4.6 车站付费区与非付费区之间的隔离栅栏上应设开向疏散\n方向的栅栏门，检票口和栅栏门的总通过能力应保证站台疏散至\n站厅的乘客不滞留在付费区。\n5.4.7 城市轨道交通车站检票口应至少设置一处无障碍专用检\n票通道，通道净宽不应小于900mm。\n5.4.8当车站不设置站台屏蔽门时，站台边缘应设置醒目的安\n全带或安全线标志；当车站设置站台屏蔽门时，自站台边缘起向\n内1m范围内的地面装饰层下应采取绝缘措施。\n5.4.9 跨座式单轨系统车站站台应设站台屏蔽门，高架车站底\n部应封闭。\n5.4.10 地下车站风亭（井）的设置应能防止气流短路，并应符\n合环境保护要求。\n5.4.11 车站内应设置导向、事故疏散等标志标识，区间隧道应\n设疏散标志。\n5.4.12 车站内应设无障碍设施。\n21"}
