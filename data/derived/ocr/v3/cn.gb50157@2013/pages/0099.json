.49],[382.48,1196.79],[182.82,1196.79]],"text":"的排水坡。"},{"confidence":0.99606,"polygon":[[180.41,1213.7],[1407.23,1214.91],[1407.23,1262.01],[180.41,1260.8]],"text":"10.5.8 钢筋混凝土和预应力混凝土结构的截面尺寸应能保证混"},{"confidence":0.99988,"polygon":[[181.62,1280.12],[1408.43,1280.12],[1408.43,1330.84],[181.62,1330.84]],"text":"凝土灌注及振捣质量。截面最小尺寸应符合现行行业标准《铁路"},{"confidence":0.99992,"polygon":[[182.82,1346.54],[1404.83,1346.54],[1404.83,1393.64],[182.82,1393.64]],"text":"桥涵钢筋混凝土和预应力混凝土结构设计规范》TB10002.3的"},{"confidence":0.99918,"polygon":[[179.21,1410.55],[374.06,1408.13],[374.06,1462.48],[179.21,1464.89]],"text":"有关规定。"},{"confidence":0.99992,"polygon":[[180.41,1478.18],[1408.43,1475.76],[1408.43,1526.48],[180.41,1528.9]],"text":"10.5.9钢筋混凝土结构中的钢筋保护层厚度、预应力混凝土结"},{"confidence":0.99981,"polygon":[[184.02,1549.43],[1406.03,1549.43],[1406.03,1592.91],[184.02,1592.91]],"text":"构中的预应力筋或管道间的净距、预应力筋或管道的保护层及钢"},{"confidence":0.99992,"polygon":[[184.02,1615.85],[1404.83,1615.85],[1404.83,1659.33],[184.02,1659.33]],"text":"筋的保护层厚度，除应符合现行行业标准《铁路桥涵钢筋混凝土"},{"confidence":0.99992,"polygon":[[186.43,1682.27],[1403.62,1682.27],[1403.62,1722.12],[186.43,1722.12]],"text":"和预应力混凝土结构设计规范》TB10002.3的有关规定外，还"},{"confidence":0.99037,"polygon":[[182.82,1745.07],[1272.52,1746.28],[1272.52,1793.38],[182.82,1792.17]],"text":"应根据不同的环境符合表10.5.9-1～表10.5.9-3的规定。"},{"confidence":0.98527,"polygon":[[321.14,1836.85],[1266.51,1836.85],[1266.51,1880.33],[321.14,1880.33]],"text":"表10.5.9-1 一般环境中混凝土材料与钢筋的保护层厚度"},{"confidence":0.99997,"polygon":[[1123.38,1920.18],[1359.12,1920.18],[1359.12,1960.03],[1123.38,1960.03]],"text":"钢筋保护层厚度"},{"confidence":0.99998,"polygon":[[256.19,1940.71],[407.74,1943.13],[406.53,1993.85],[254.99,1991.43]],"text":"环境"},{"confidence":0.99987,"polygon":[[513.58,1949.17],[746.91,1949.17],[746.91,1985.4],[513.58,1985.4]],"text":"混凝土强度等级"},{"confidence":0.99996,"polygon":[[839.53,1946.75],[1012.73,1946.75],[1012.73,1987.81],[839.53,1987.81]],"text":"最大水胶比"},{"confidence":0.88466,"polygon":[[1191.94,1970.9],[1290.56,1970.9],[1290.56,2018.0],[1191.94,2018.0]],"text":"(mm)"},{"confidence":0.99842,"polygon":[[229.73,2053.02],[434.2,2053.02],[434.2,2092.88],[229.73,2092.88]],"text":"非干湿交替和"},{"confidence":1.0,"polygon":[[595.37,2048.19],[667.53,2048.19],[667.53,2095.29],[595.37,2095.29]],"text":"C35"},{"confidence":1.0,"polygon":[[893.65,2045.78],[964.61,2050.61],[962.21,2096.5],[891.25,2091.67]],"text":"0.5"},{"confidence":1.0,"polygon":[[1215.99,2049.4],[1267.71,2049.4],[1267.71,2095.29],[1215.99,2095.29]],"text":"35"},{"confidence":0.99996,"polygon":[[230.93,2108.58],[434.2,2108.58],[434.2,2148.43],[230.93,2148.43]],"text":"长期湿润环境"},{"confidence":0.99984,"polygon":[[579.73,2106.16],[681.97,2106.16],[681.97,2149.64],[579.73,2149.64]],"text":"≥C40"},{"confidence":1.0,"polygon":[[887.64,2106.16],[969.43,2106.16],[969.43,2149.64],[887.64,2149.64]],"text":"0.45"},{"confidence":1.0,"polygon":[[1217.19,2107.37],[1265.31,2107.37],[1265.31,2149.64],[1217.19,2149.64]],"text":"30"},{"confidence":1.0,"polygon":[[204.47,2203.98],[268.22,2203.98],[268.22,2258.33],[204.47,2258.33]],"text":"80"}],"page_number":99,"render_dpi":300,"schema_version":1,"source_pdf_sha256":"a1130f89afba11f00fdb3353375aa1c424b4eb44d462ee6bd1de2835c235dab3","spec_id":"cn.gb50157","text":"定，且直径不宜小于150mm。排水管出水口不得紧贴混凝土构\n件表面，应设滴水檐防止水从侧面淌入梁、板底面。\n10.5.3桥面应设防水层。梁缝处应设伸缩缝，伸缩缝除应保证\n梁部能自由伸缩外，还应有效防止桥面水渗漏。\n10.5.4采用直流电力牵引和走行轨回流的高架结构，应根据现\n行行业标准《地铁杂散电流腐蚀防护技术规程》CJJ49的有关\n规定采取防止杂散电流腐蚀的措施。钢结构及钢连接件应进行防\n锈处理。\n10.5.5 桥下应设养护、维修便道，便道的宽度应满足自行走行\n升降式桥梁检修车能进行检修作业要求；高度超过20m、桥下无\n条件设置养护维修便道处，宜设置专门检查设备。\n10.5.6 箱形结构应有进入箱内检查的孔道。箱梁腹板上应设置\n适当数量的直径为100mm的通风孔。\n10.5.7 墩柱顶面应预留更换支座时顶梁的位置，并应设置3%\n的排水坡。\n10.5.8 钢筋混凝土和预应力混凝土结构的截面尺寸应能保证混\n凝土灌注及振捣质量。截面最小尺寸应符合现行行业标准《铁路\n桥涵钢筋混凝土和预应力混凝土结构设计规范》TB10002.3的\n有关规定。\n10.5.9钢筋混凝土结构中的钢筋保护层厚度、预应力混凝土结\n构中的预应力筋或管道间的净距、预应力筋或管道的保护层及钢\n筋的保护层厚度，除应符合现行行业标准《铁路桥涵钢筋混凝土\n和预应力混凝土结构设计规范》TB10002.3的有关规定外，还\n应根据不同的环境符合表10.5.9-1～表10.5.9-3的规定。\n表10.5.9-1 一般环境中混凝土材料与钢筋的保护层厚度\n钢筋保护层厚度\n环境\n混凝土强度等级\n最大水胶比\n(mm)\n非干湿交替和\nC35\n0.5\n35\n长期湿润环境\n≥C40\n0.45\n30\n80"}
