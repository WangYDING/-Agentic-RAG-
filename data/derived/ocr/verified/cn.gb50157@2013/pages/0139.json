.72],[180.41,1183.51]],"text":"13.1.10 通风、空调与供暖系统的设备、管道及配件布置，应"},{"confidence":0.9999,"polygon":[[182.82,1201.62],[1408.43,1201.62],[1408.43,1252.34],[182.82,1252.34]],"text":"保证系统整体高效运行，并应为安装、操作测量、调试和维修"},{"confidence":0.93233,"polygon":[[182.82,1268.04],[495.54,1268.04],[495.54,1316.35],[182.82,1316.35]],"text":"预留空间位置。"},{"confidence":0.99993,"polygon":[[182.82,1334.47],[342.79,1334.47],[342.79,1379.15],[182.82,1379.15]],"text":"13.1.11"},{"confidence":0.99983,"polygon":[[315.12,1329.64],[1407.23,1333.26],[1407.23,1388.81],[315.12,1385.19]],"text":"1工程设计应为大型通风、空调与供暖设备设有运输、"},{"confidence":0.99989,"polygon":[[181.62,1396.06],[954.99,1399.68],[954.99,1447.99],[181.62,1444.36]],"text":"安装通道及孔洞，并应能装设起吊设施。"},{"confidence":0.9999,"polygon":[[175.6,1456.44],[1413.24,1456.44],[1413.24,1519.24],[175.6,1519.24]],"text":"13.1.12通风、空调与供暖系统的机房应设置设备起吊和冲洗"},{"confidence":1.0,"polygon":[[176.81,1527.69],[297.08,1527.69],[297.08,1584.45],[176.81,1584.45]],"text":"设施。"},{"confidence":0.99433,"polygon":[[182.82,1598.94],[1403.62,1598.94],[1403.62,1642.42],[182.82,1642.42]],"text":"13.1.13 通风、空调与供暖系统的管材及保温材料、消声材料，"},{"confidence":0.99989,"polygon":[[184.02,1664.16],[1403.62,1664.16],[1403.62,1707.63],[184.02,1707.63]],"text":"应采用A级不燃材料，当局部部位采用A级不燃材料有困难时，"},{"confidence":0.99949,"polygon":[[185.23,1730.58],[1404.83,1730.58],[1404.83,1774.05],[185.23,1774.05]],"text":"可采用B1级难燃材料。管材及保温材料应具有防潮、防腐、防"},{"confidence":0.99948,"polygon":[[182.82,1795.79],[685.57,1795.79],[685.57,1839.27],[182.82,1839.27]],"text":"蛀、耐老化和无毒的性能。"},{"confidence":0.99336,"polygon":[[442.62,1893.61],[1143.83,1893.61],[1143.83,1937.09],[442.62,1937.09]],"text":"13.2 地下线段的通风、空调与供暖"},{"confidence":0.9525,"polygon":[[582.14,2022.83],[1013.93,2019.21],[1013.93,2067.52],[582.14,2071.14]],"text":"I 区间隧道通风系统"},{"confidence":0.99802,"polygon":[[184.02,2123.07],[1406.03,2123.07],[1406.03,2166.54],[184.02,2166.54]],"text":"13.2.1 区间隧道正常通风应采用活塞通风，当活塞通风不能满"},{"confidence":1.0,"polygon":[[204.47,2202.77],[289.87,2202.77],[289.87,2258.33],[204.47,2258.33]],"text":"120"}],"page_number":139,"render_dpi":300,"schema_version":1,"source_pdf_sha256":"a1130f89afba11f00fdb3353375aa1c424b4eb44d462ee6bd1de2835c235dab3","spec_id":"cn.gb50157","text":"采用空调系统；\n4在夏季当地最热月的平均温度超过25℃，全年平均温度\n超过15℃，且地铁高峰时间内每小时的行车对数和每列车车辆\n数的乘积不小于120时，应采用空调系统。\n13.1.6 地铁地下线路通风与空调系统制式应结合地铁的运力、\n当地的气候条件、人员舒适性要求和运行及维护费用等因素进行\n综合技术经济比较确定。\n13.1.7 地铁的通风、空调与供暖系统应按地铁预测的远期客流量\n和最大的通过能力设计，设备宜按近期和远期配置，并宜分期实施。\n13.1.8 地铁的通风、空调与供暖系统设计和设备配置应贯彻国\n家能源政策，践行运营节能原则，并宜利用自然冷、热源。\n13.1.9 车辆基地、控制中心和主变电所等地面建筑，应在满足\n工艺要求的前提下，按本规范和国家现行有关建筑设计标准的规\n定设置通风、空调与供暖系统。\n13.1.10 通风、空调与供暖系统的设备、管道及配件布置，应\n保证系统整体高效运行，并应为安装、操作测量、调试和维修\n预留空间位置。\n13.1.11\n1工程设计应为大型通风、空调与供暖设备设有运输、\n安装通道及孔洞，并应能装设起吊设施。\n13.1.12通风、空调与供暖系统的机房应设置设备起吊和冲洗\n设施。\n13.1.13 通风、空调与供暖系统的管材及保温材料、消声材料，\n应采用A级不燃材料，当局部部位采用A级不燃材料有困难时，\n可采用B1级难燃材料。管材及保温材料应具有防潮、防腐、防\n蛀、耐老化和无毒的性能。\n13.2 地下线段的通风、空调与供暖\nI 区间隧道通风系统\n13.2.1 区间隧道正常通风应采用活塞通风，当活塞通风不能满\n120"}
