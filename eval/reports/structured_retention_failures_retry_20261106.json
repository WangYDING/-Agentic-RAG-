          "display_ref": "第10.2.1条",
          "score": 0.6641566753387451,
          "rerank_score": null,
          "metadata": {},
          "spec_id": "cn.beijing.db11t995",
          "edition_id": "2025",
          "standard_code": "DB11/T 995-2025",
          "spec_title": "城市轨道交通工程设计标准",
          "pdf_page_start": 59,
